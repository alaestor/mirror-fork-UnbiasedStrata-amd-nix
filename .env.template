# Trusted shell configuration, loaded from the current directory.
# Copy to .env and edit. CLI options override these settings.
STRATA_MODEL="$HOME/Downloads/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf"
STRATA_PREPARED_DIR="$HOME/.local/share/unbiased-strata/qwen36"
# Optional Qwen3.6 image input. Use its own projector, not Qwen3.8's.
# Leave empty for text only. Example:
# STRATA_MMPROJ="$HOME/Downloads/Qwen3.6-35B-A3B-vision-mmproj-BF16.gguf"
STRATA_MMPROJ=
STRATA_VISION_TOKENS=1024
STRATA_CTX=32768
STRATA_HOST=127.0.0.1
STRATA_PORT=8080
STRATA_KV=q4_0
# Empty values use the engine's automatic sizing.
STRATA_THREADS=
STRATA_VRAM_CAP_MIB=
STRATA_RAM_CAP_GIB=

# Flash-Next uses separate model paths and sizing. Shared host/port/threads/KV
# settings above still apply. Total memory is enforced by a systemd user service.
STRATA_QWEN38_MODEL="$HOME/Downloads/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf"
STRATA_QWEN38_PREPARED_DIR="$HOME/.local/share/unbiased-strata/qwen38"
# Optional image input. Download the matching projector separately; leave empty for text only.
# STRATA_QWEN38_MMPROJ="$HOME/Downloads/Qwen3.8-Flash-Next-vision-mmproj-BF16.gguf"
STRATA_QWEN38_MMPROJ=
STRATA_QWEN38_VISION_TOKENS=1024
# Required only for local preparation: raw BF16 draft tensors plus mtp-manifest.json.
# Explicitly supply a local directory; prepare-qwen38 never fetches missing inputs.
STRATA_QWEN38_MTP_SOURCE=
STRATA_QWEN38_CTX=8192
STRATA_QWEN38_RAM_CAP_GIB=40
STRATA_QWEN38_MEMORY_MAX=48G
# Keep GPU memory available for the desktop. This reserves sizing headroom;
# unlike --vram-cap, it does not allocate a VRAM blocker.
STRATA_QWEN38_VRAM_RESERVE_MIB=4096
